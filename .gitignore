# YYC3 CloudPivot Matrix 工作区根 .gitignore（Phase 0 冻结）
# 依赖与产物
node_modules/
dist/
dist-electron/
release/
build/
*.tsbuildinfo
# 本地 pnpm store（沙箱环境写 ~/.pnpm-store 受限时的项目内替代）
.pnpm-store-local/

# 环境与密钥（红线：敏感信息不入库）
.env
.env.*
!.env.example

# 日志与系统文件
*.log
.DS_Store
# 例外：Phase 0/1 证据日志（留档 DoD）
!docs/YYC3-组件拆分-指导文档/phase0-ledger/attachments/*.log
!docs/YYC3-组件拆分-指导文档/phase1-ledger/attachments/*.log

# 不提交文件夹
docs/AI-Family-Agent-模块复用指导.md
docs/yyc3-login-page/
docs/yyc3-management/
docs/yyc3-mono/
docs/yyc3-packages/
docs/yyc3-ui-mono/
docs/yyc3-ui-organized/
docs/ai-assistant-dev/
