{
  "name": "@yyc3/monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "description": "YYC³ CloudPivot Matrix 统一 Monorepo 底座（M1）— 四端应用 + 共享包",
  "author": "YanYuCloudCube Team <admin@0379.email>",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "pnpm -r build",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "gates": "bash scripts/verify-gates.sh",
    "gates:quick": "bash scripts/verify-gates.sh --skip-build",
    "dev:web-full": "pnpm --filter @yyc3/app-web-full dev",
    "dev:sandbox-lite": "pnpm --filter @yyc3/app-sandbox-lite dev",
    "dev:desktop": "pnpm --filter @yyc3/app-desktop dev",
    "dev:web-classic": "pnpm --filter @yyc3/app-web-classic dev"
  }
}
