# ── YYC³ LeisureAPI 开发环境配置样例 ──
# 复制为 .env 后填写;真实密钥不入 git(凭证纪律:只存 ~/.yyc3-keybackup)

NODE_ENV=dev
PORT=3001

# PostgreSQL 15(2026-11-02 由 MySQL 切换)。开发:compose 映射 5434→5432(本机 5433 为生产主库,勿连);
# 生产:宿主主库 <PRIMARY_HOST>:5433(NAS 192.168.3.45 为流复制备库,只读)。
# 运行时用受限账号 leisure_app;迁移用所有者账号(见 docker/pg-init 与 scripts/apply-pg-grants.sql)
DATABASE_URL=postgresql://leisure_app:CHANGE_ME@127.0.0.1:5434/leisure?schema=public

# Redis(本地 compose 映射 6380→6379,避开本机既有 6379 实例)
REDIS_URL=redis://127.0.0.1:6380

# JWT(生产必须替换为强随机,≥32 字符)
JWT_SECRET=dev-only-change-me-32chars-min!!
JWT_REFRESH_SECRET=dev-only-refresh-change-me-32ch
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=7d

# 营业日/业务规则
BUSINESS_DAY_CUT=08:00
TRANSFER_MODE=manual
MANUAL_DEDUCT_THRESHOLD=500
ALLOW_NEGATIVE_BALANCE=true
ALLOW_STAGE_WITHOUT_CHECKIN=false
CHECKOUT_MIN_MINUTES=60

# 预置口令时限(小时):建号/重置后超时未首登改密 → 登录冻结,联系管理员重置
PRESET_PASSWORD_TTL_HOURS=24

# 计费进位阈值(分钟,默认15;门店级「艺人设置-包厢计费规则」可覆盖)
BILL_ROUNDING_MINUTES=15

# 硬件语音盒子(钟房叫钟联动;留空=仅大屏 Web Speech)。
# URL 模板须含 {text} 占位,主机须为店内私网/局域网(代码强制校验);示例:
# VOICE_BOX_URL=http://192.168.1.50/tts?text={text}
# VOICE_BOX_TIMEOUT_MS=3000
# dev 联调可用 mock 盒子:node scripts/mock-voice-box.mjs 后指向 http://127.0.0.1:3999/tts?text={text}
VOICE_BOX_URL=
VOICE_BOX_TIMEOUT_MS=3000

# 开放 API 生态预留(2026-11-01 v1.1 裁决:原主系统联动开关废止)
OPENAPI_ENABLED=false

# 微信小程序(就绪后填写;未填时 code 即 openid 仅限 dev)
WX_APPID=
WX_SECRET=
