# YYC³ LeisureAPI · 生产镜像(自含依赖;多阶段)
# 构建上下文 = monorepo 根(需要 packages/leisure-core 与 services/leisure-api):
#   docker build -f services/leisure-api/deploy/nas/Dockerfile.prod -t leisure-api:prod .
# 说明:为保证 Prisma 生成产物与 workspace 依赖完整,运行阶段整体复制构建阶段的仓库目录
#      (镜像偏大但零风险;瘦身可后续改 pnpm deploy)。首次在 NAS 构建后以 /api/v1/auth/me 401 作连通性冒烟。

FROM node:22-alpine AS builder
RUN apk add --no-cache openssl
RUN corepack enable && corepack prepare pnpm@12.11.2 --activate
WORKDIR /repo
COPY . .
# 仅安装 API 及其 workspace 依赖(leisure-core)所需的包
RUN pnpm install --frozen-lockfile --filter leisure-api... --filter @yyc3/leisure-core...
RUN pnpm --filter @yyc3/leisure-core build
RUN pnpm --filter leisure-api exec prisma generate
RUN pnpm --filter leisure-api build

FROM node:22-alpine
RUN apk add --no-cache openssl
ENV NODE_ENV=prod
ENV TZ=Asia/Shanghai
WORKDIR /repo/services/leisure-api
COPY --from=builder /repo /repo
EXPOSE 3001
# 环境变量由 compose env_file 注入(不进镜像)
CMD ["node", "dist/main.js"]
