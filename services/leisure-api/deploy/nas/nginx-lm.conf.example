# YYC³ LeisureManage · 边缘网关 nginx 示例(39.97.53.176 · 阿里云)
# 域名:lm.0379.pro(Web 管理端) / lm.0379.world(艺人端 H5) —— 均需 ICP 备案(接入商:阿里云)
# 链路:边缘 nginx(TLS 终止) → NAS yyc3-45(内网 192.168.3.45 或隧道地址)→ API 容器 3001
# 证书:certbot --nginx -d lm.0379.pro -d lm.0379.world(DNS 先 A 记录到 39.97.53.176)
# ⚠️ 未备案前 80/443 会被接入商阻断;过渡期用 Tailscale 直连 NAS(见 ENV-生产变量说明.md §六)

# ── HTTP → HTTPS ──
server {
  listen 80;
  server_name lm.0379.pro lm.0379.world;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://$host$request_uri; }
}

# ── Web 管理端 ──
server {
  listen 443 ssl http2;
  server_name lm.0379.pro;

  ssl_certificate     /etc/letsencrypt/live/lm.0379.pro/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/lm.0379.pro/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header X-Frame-Options SAMEORIGIN always;
  add_header X-Content-Type-Options nosniff always;
  client_max_body_size 20m;

  # API → NAS(占位 <NAS_ADDR>=192.168.3.45 或隧道地址;端口 3001)
  location /api/v1/ {
    proxy_pass http://<NAS_ADDR>:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }

  # Swagger 生产默认关;如临时开启建议限内网
  # location /docs { deny all; }

  # Web 管理端静态(hash router 构建产物,apps/app-leisure-web/dist)
  root /var/www/leisure-web;
  location / { try_files $uri $uri/ /index.html; }
}

# ── 艺人端 H5 ──
server {
  listen 443 ssl http2;
  server_name lm.0379.world;

  ssl_certificate     /etc/letsencrypt/live/lm.0379.pro/fullchain.pem;   # 或单域名证书
  ssl_certificate_key /etc/letsencrypt/live/lm.0379.pro/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  add_header X-Frame-Options SAMEORIGIN always;
  add_header X-Content-Type-Options nosniff always;
  client_max_body_size 10m;

  location /api/v1/ {
    proxy_pass http://<NAS_ADDR>:3001;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
    proxy_read_timeout 60s;
  }

  # 艺人端 H5(Taro 构建产物,TARO_APP_API_BASE=https://lm.0379.pro/api/v1)
  root /var/www/leisure-h5;
  location / { try_files $uri $uri/ /index.html; }
}
