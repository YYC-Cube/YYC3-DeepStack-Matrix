// ─────────────── 权限 ───────────────

model AdminUser {
  id           Int      @id @default(autoincrement())
  storeId      Int?     @map("store_id")
  name         String   @db.VarChar(64)
  phone        String   @db.VarChar(20) @unique
  // 登录用户名(测试/非手机号账号;可空唯一)
  username     String?  @unique @db.VarChar(32)
  passwordHash String   @map("password_hash") @db.VarChar(128)
  // 首登必改:seed/管理员重置的默认密码置 true;改密成功置 false;为 true 时除改密/me/登录外接口一律 40302
  mustChangePassword Boolean @default(false) @map("must_change_password")
  roleId       Int?     @map("role_id")
  status       Int      @default(1)
  // 登录防爆破:连错 5 次锁 15 分钟(42901);成功登录即复位
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  // 员工管理(2026-11-03 组织架构批次):部门/职级/直属上级
  departmentId Int?     @map("department_id")
  // 职级:VP=销售副总(管理职) MANAGER_DIRECTOR=销售总监(管理职) MANAGER=销售经理 CASHIER=收银 FINANCE=财务
  title        String?  @db.VarChar(32)
  managerId    Int?     @map("manager_id")
  createdAt    DateTime @default(now()) @map("created_at")

  role       Role?       @relation(fields: [roleId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@map("admin_user")
}

