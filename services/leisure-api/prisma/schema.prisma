  content     String   @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at")

  chatGroup ChatGroup @relation(fields: [chatGroupId], references: [id])

  @@index([chatGroupId, id])
  @@map("chat_message")
}
