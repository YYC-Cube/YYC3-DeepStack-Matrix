// YYC³ LeisureManage · Prisma Schema(MySQL 8)
// 依据:《11-数据库完整规划》全量表清单;流水/审计表应用层禁改(见 10 号文档 §REVOKE)

generator client {
  provider = "prisma-client-js"
  // 多引擎:宿主 darwin-arm64(native)+ 容器 node:22-alpine(arm64 musl;openssl 双版本兜底检测差异)
  // 注:target 名内嵌 arm64——本仓库容器固定 arm64(Apple Silicon 开发机),x64 宿主需调整
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────── 主数据 ───────────────

model Store {
  id                  Int       @id @default(autoincrement())
  name                String    @db.VarChar(64)
  address             String?   @db.VarChar(255)
  city                String?   @db.VarChar(64)
  businessDayCutTime  String    @default("08:00") @map("business_day_cut_time") @db.VarChar(5)
  externalId          String?   @map("external_id") @db.VarChar(64) @unique
  status              Int       @default(1)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  roomTypes     RoomType[]
  rooms         Room[]
  artists       Artist[]
  artistGroups  ArtistGroup[]
  artistLevels  ArtistLevel[]
  stageFeeRules StageFeeRule[]
  ticketRules   TicketRule[]

  @@map("store")
}

model RoomType {
  id         Int     @id @default(autoincrement())
  storeId    Int     @map("store_id")
  name       String  @db.VarChar(32) // 实测:小包/中包/大包/VIP包/西亳厅/外卖房
  externalId String? @map("external_id") @db.VarChar(64)
  sort       Int     @default(0)
  status     Int     @default(1)

  store        Store         @relation(fields: [storeId], references: [id])
  rooms        Room[]
  pricingSlots PricingSlot[]

  @@unique([storeId, name])
  @@map("room_type")
}

// ─────────────── 包厢房号(需求全集 §5) ───────────────

model Room {
  id         Int      @id @default(autoincrement())
  storeId    Int      @map("store_id")
  roomNo     String   @map("room_no") @db.VarChar(32) // 房号,店内唯一(如 A01、VIP03)
  roomName   String?  @map("room_name") @db.VarChar(64)
  roomTypeId Int      @map("room_type_id")
  capacity   Int? // 容纳人数
  status     String   @default("FREE") @db.VarChar(16) // FREE/OCCUPIED/CLEANING/MAINTENANCE/DISABLED
  remark     String?  @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store        Store          @relation(fields: [storeId], references: [id])
  roomType     RoomType       @relation(fields: [roomTypeId], references: [id])
  roomSessions RoomSession[]

  @@unique([storeId, roomNo])
  @@index([storeId, status])
  @@map("room")
}

// ─────────────── 档案三元组 ───────────────

model ArtistGroup {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  // 条线隔离(2026-11-04 Owner 裁决:销售/资源经理并非同一组织,组别不互通;存量 NULL 视同 SELL)
  line           String?  @map("line") @db.VarChar(16)
  name           String   @db.VarChar(64) // 实测以主管命名:江海龙
  supervisorName String?  @map("supervisor_name") @db.VarChar(64)
  deletedAt      DateTime? @map("deleted_at")

  store   Store    @relation(fields: [storeId], references: [id])
  artists Artist[] @relation("group")

  @@unique([storeId, name, deletedAt])
  @@map("artist_group")
}

model ArtistLevel {
  id        Int       @id @default(autoincrement())
  storeId   Int       @map("store_id")
  // 条线隔离(同组别;存量 NULL 视同 SELL)
  line      String?   @map("line") @db.VarChar(16)
  name      String    @db.VarChar(64) // 实测:技师
  deletedAt DateTime? @map("deleted_at")

  store   Store    @relation(fields: [storeId], references: [id])
  artists Artist[] @relation("level")

  @@unique([storeId, name, deletedAt])
  @@map("artist_level")
}

/// 工作通告阅读记录(触达统计:谁看过/各职级触达率;2026-11-04)
model NoticeRead {
  id          Int      @id @default(autoincrement())
  storeId     Int      @map("store_id")
  noticeId    Int      @map("notice_id")
  userId      Int      @map("user_id")
  // 阅读者维度:ADMIN(按 admin_user.title 记职级)/ARTIST(销售经理)
  viewerScope String   @map("viewer_scope") @db.VarChar(16)
  viewerTitle String?  @map("viewer_title") @db.VarChar(32)
  viewedAt    DateTime @default(now()) @map("viewed_at")

  notice Notice @relation(fields: [noticeId], references: [id])

  @@unique([noticeId, userId])
  @@index([storeId, noticeId])
  @@map("notice_read")
}

// ─────────────── 财务分账(17 号闭环规划;III-B S1) ───────────────

/// 分账方案(类目×周期;状态机 DRAFT→ACTIVE→ARCHIVED)
model SplitPlan {
  id            Int       @id @default(autoincrement())
  storeId       Int       @map("store_id")
  name          String    @db.VarChar(64)
  // 类目:SESSION 上钟业绩 / ROOM 房账消费 / ORDER 自点单 / TICKET 台票销售 / RECHARGE 充值业绩 / MANUAL 手动调整
  category      String    @db.VarChar(16)
  periodType    String    @default("MONTHLY") @map("period_type") @db.VarChar(16) // DAILY/WEEKLY/MONTHLY
  status        String    @default("DRAFT") @db.VarChar(16) // DRAFT/ACTIVE/ARCHIVED
  // 计划期预算(17 号 S3+:预算 vs 实际对比;空=不设预算)
  budgetAmount Decimal?  @map("budget_amount") @db.Decimal(12, 2)
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  rules   SplitRule[]
  entries SplitEntry[]

  @@index([storeId, status])
  @@map("split_plan")
}

/// 分账规则项(岗位/条线 × 计算方式 × 支付方式 × 奖惩正负)
model SplitRule {
  id          Int       @id @default(autoincrement())
  planId      Int       @map("plan_id")
  // 适用维度:匹配条件(空=全员);三者可组合
  applyTitle  String?   @map("apply_title") @db.VarChar(32)
  applyLine   String?   @map("apply_line") @db.VarChar(16)
  applyDepartmentId Int? @map("apply_department_id")
  // 计算方式:PERCENT 比例 / FIXED 固定金额 / TIERED 阶梯(tierJson)
  calcType    String    @map("calc_type") @db.VarChar(16)
  percent     Decimal?  @db.Decimal(6, 2)
  fixedAmount Decimal?  @map("fixed_amount") @db.Decimal(12, 2)
  tierJson    Json?     @map("tier_json") // [{min,max,percent}]
  // 奖惩:REWARD 奖励(正) PENALTY 惩罚(负)
  rewardType  String    @default("REWARD") @map("reward_type") @db.VarChar(16)
  // 支付方式:CASH/TRANSFER/BANK/OFFSET(冲抵台费)
  payMethod   String    @default("CASH") @map("pay_method") @db.VarChar(16)
  createdAt   DateTime  @default(now()) @map("created_at")

  plan   SplitPlan   @relation(fields: [planId], references: [id])
  entries SplitEntry[]

  @@index([planId])
  @@map("split_rule")
}

/// 分账计提记录(只增;冲正=反向条目;基数快照留痕)
model SplitEntry {
  id          Int       @id @default(autoincrement())
  storeId     Int       @map("store_id")
  planId      Int       @map("plan_id")
  ruleId      Int       @map("rule_id")
  businessDate DateTime @map("business_date") @db.Date
  // 分账对象:ARTIST(销售/资源经理)或 ADMIN(岗位)
  targetScope String    @map("target_scope") @db.VarChar(16)
  targetId    Int       @map("target_id")
  targetName  String    @map("target_name") @db.VarChar(64)
  baseAmount  Decimal   @map("base_amount") @db.Decimal(12, 2)
  amount      Decimal   @db.Decimal(12, 2) // 正=奖励 负=奖惩/冲正
  // ACCRUED 计提 → CONFIRMED 复核 → PAID 已支付;REVERSED 冲正
  status      String    @default("ACCRUED") @db.VarChar(16)
  payMethod   String?   @map("pay_method") @db.VarChar(16)
  payRef      String?   @map("pay_ref") @db.VarChar(64)
  refType     String?   @map("ref_type") @db.VarChar(16)
  refId       Int?
  settlementId Int?     @map("settlement_id")
  operatorId  Int       @map("operator_id")
  remark      String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")

  plan   SplitPlan        @relation(fields: [planId], references: [id])
  rule   SplitRule        @relation(fields: [ruleId], references: [id])
  settlement SplitSettlement? @relation(fields: [settlementId], references: [id])

  @@index([storeId, businessDate])
  @@index([planId, status])
  @@map("split_entry")
}

model SplitSettlement {
  id          Int       @id @default(autoincrement())
  storeId     Int       @map("store_id")
  // 结算对象
  targetScope String    @map("target_scope") @db.VarChar(16)
  targetId    Int       @map("target_id")
  targetName  String    @map("target_name") @db.VarChar(64)
  periodFrom  DateTime  @map("period_from") @db.Date
  periodTo    DateTime  @map("period_to") @db.Date
  amount      Decimal   @db.Decimal(12, 2)
  entryCount  Int       @map("entry_count")
  payMethod   String    @map("pay_method") @db.VarChar(16)
  // CONFIRMED 复核 → PAID 已支付
  status      String    @default("CONFIRMED") @db.VarChar(16)
  confirmedBy Int       @map("confirmed_by")
  paidAt      DateTime? @map("paid_at")
  payRef      String?   @map("pay_ref") @db.VarChar(64)
  createdAt   DateTime  @default(now()) @map("created_at")

  entries SplitEntry[]

  @@index([storeId, createdAt])
  @@map("split_settlement")
}

/// 分账结算单(按对象+周期汇总计提;复核→支付)
// ─────────────── 交接班对账(008 #3;III-B) ───────────────

/// 交接班快照(当班金额四合计+未结订单;生成→接班确认)
model ShiftHandover {
  id           Int       @id @default(autoincrement())
  storeId      Int       @map("store_id")
  businessDate DateTime  @map("business_date") @db.Date
  shiftName    String    @map("shift_name") @db.VarChar(32) // 如 早班/晚班
  handedBy     Int       @map("handed_by")
  // 金额快照(生成时冻结;JSON 留扩展)
  rechargeTotal Decimal  @map("recharge_total") @db.Decimal(12, 2)
  deductTotal   Decimal  @map("deduct_total") @db.Decimal(12, 2)
  settleTotal   Decimal  @map("settle_total") @db.Decimal(12, 2)
  orderTotal    Decimal  @map("order_total") @db.Decimal(12, 2)
  openOrders    Int      @map("open_orders")
  summaryJson   Json?    @map("summary_json")
  // OPEN 生成 → CONFIRMED 接班人确认(接班码校验:创建时生成 6 位码,确认须提供)
  status       String    @default("OPEN") @db.VarChar(16)
  confirmCode  String?   @map("confirm_code") @db.VarChar(8)
  takenBy      Int?      @map("taken_by")
  confirmedAt  DateTime? @map("confirmed_at")
  remark       String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([storeId, businessDate])
  @@map("shift_handover")
}

model Artist {
  id                  Int       @id @default(autoincrement())
  storeId             Int       @map("store_id")
  groupId             Int?      @map("group_id")
  // 专业条线:SELL=销售经理线(默认/存量) RESOURCE=资源经理线(2026-11-04 财务分账条线前置)
  line                String?   @map("line") @db.VarChar(16)
  supervisorName      String?   @map("supervisor_name") @db.VarChar(64)
  levelId             Int?      @map("level_id")
  realName            String    @map("real_name") @db.VarChar(64)
  stageName           String?   @map("stage_name") @db.VarChar(64)
  gender              Int       @default(1) // 1 女(实测默认) 2 男
  phone               String?   @db.VarChar(20)
  badgeNo             String?   @map("badge_no") @db.VarChar(32)
  idCardNoEnc         Bytes?    @map("id_card_no_enc")
  idCardImgKey        String?   @map("id_card_img_key") @db.VarChar(255)
  avatarKeys          Json?     @map("avatar_keys")
  tags                Json?
  performanceTarget   Decimal   @default(0) @map("performance_target") @db.Decimal(12, 2)
  maxTotalShows       Int       @default(0) @map("max_total_shows") // 0=不限
  maxCrossRooms       Int       @default(0) @map("max_cross_rooms") // 0=不允许串台
  firstShowMinMinutes Int       @default(0) @map("first_show_min_minutes")
  sameRoomMinMinutes  Int       @default(0) @map("same_room_min_minutes")
  workStartMode       String    @default("FREE") @map("work_start_mode") @db.VarChar(8)
  workStart           String?   @map("work_start") @db.VarChar(5)
  workEndMode         String    @default("FREE") @map("work_end_mode") @db.VarChar(8)
  workEnd             String?   @map("work_end") @db.VarChar(5)
  tipFixed            Decimal   @default(0) @map("tip_fixed") @db.Decimal(10, 2)
  hourlyRate          Decimal   @default(0) @map("hourly_rate") @db.Decimal(10, 2)
  wechatOpenid        String?   @map("wechat_openid") @db.VarChar(64) @unique
  status              Int       @default(1) // 1在职 0停用 2已转移
  auditStatus         String    @default("PENDING") @map("audit_status") @db.VarChar(16) // PENDING/REJECTED/APPROVED(需求全集 §3)
  deletedAt           DateTime? @map("deleted_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  store        Store            @relation(fields: [storeId], references: [id])
  group        ArtistGroup?     @relation("group", fields: [groupId], references: [id])
  level        ArtistLevel?     @relation("level", fields: [levelId], references: [id])
  reports             AttendanceReport[]
  sessions            ShowSession[]
  feeTxns             StageFeeTxn[]
  ticketTxns          TicketTxn[]
  reviews             ArtistReview[]
  bookings            ArtistBooking[]
  roomSessionArtists  RoomSessionArtist[]
  selfOrders          SelfOrder[]
  showcaseCasts ShowcaseCast[]
  dispatchLogs  DispatchLog[]

  @@unique([storeId, badgeNo])
  @@index([storeId, stageName])
  @@index([storeId, groupId])
  @@index([storeId, auditStatus])
  @@map("artist")
}

// ─────────────── 绑定与转移 ───────────────

model WechatBindLog {
  id            Int      @id @default(autoincrement())
  openid        String   @db.VarChar(64)
  artistId      Int      @map("artist_id")
  storeId       Int      @map("store_id")
  action        String   @db.VarChar(16) // BIND/UNBIND/TRANSFER_IN/TRANSFER_OUT/AUTO_DELETE
  prevStoreId   Int?     @map("prev_store_id")
  prevArtistId  Int?     @map("prev_artist_id")
  mode          String   @db.VarChar(8) // MANUAL/AUTO
  operatorId    Int?     @map("operator_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([openid])
  @@index([artistId])
  @@map("wechat_bind_log")
}

model TransferWorkorder {
  id            Int       @id @default(autoincrement())
  openid        String    @db.VarChar(64)
  fromStoreId   Int       @map("from_store_id")
  fromArtistId  Int       @map("from_artist_id")
  toStoreId     Int       @map("to_store_id")
  toBadgeNo     String?   @map("to_badge_no") @db.VarChar(32)
  status        String    @default("PENDING") @db.VarChar(16) // PENDING/FROM_OK/TO_OK/DONE/REJECTED/CANCELLED
  payload       Json?
  createdBy     Int       @map("created_by")
  decidedBy     Int?      @map("decided_by")
  decidedAt     DateTime? @map("decided_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([status])
  @@index([openid])
  @@map("transfer_workorder")
}

// ─────────────── 考勤 ───────────────

model AttendanceReport {
  id            Int       @id @default(autoincrement())
  storeId       Int       @map("store_id")
  businessDate  DateTime  @map("business_date") @db.Date
  artistId      Int       @map("artist_id")
  groupId       Int?      @map("group_id")
  supervisorName String?  @map("supervisor_name") @db.VarChar(64)
  type          String    @db.VarChar(16) // CHECKIN/PEIBAN/SISHI/ZAOTUI/CHIDAO/LIJIA/QITA/WEIBAO
  reportTime    DateTime  @map("report_time")
  checkinLat    Decimal?  @map("checkin_lat") @db.Decimal(10, 6)
  checkinLng    Decimal?  @map("checkin_lng") @db.Decimal(10, 6)
  checkinGeoOk  Boolean   @default(true) @map("checkin_geo_ok")
  checkoutTime  DateTime? @map("checkout_time")
  checkoutLat   Decimal?  @map("checkout_lat") @db.Decimal(10, 6)
  checkoutLng   Decimal?  @map("checkout_lng") @db.Decimal(10, 6)
  source        Int       @default(0) // 0自助 1补打卡
  operatorId    Int?      @map("operator_id")
  remark        String?   @db.VarChar(255)
  // 报备审核(艺人设置②):requireReview=true 时新报备为 PENDING,汇总/实时仅计 APPROVED;补打卡亦走此流
  reviewStatus  String    @default("APPROVED") @map("review_status") @db.VarChar(16) // APPROVED/PENDING/REJECTED
  reviewedBy    Int?      @map("reviewed_by")
  reviewedAt    DateTime? @map("reviewed_at")

  artist Artist @relation(fields: [artistId], references: [id])

  @@index([storeId, businessDate])
  @@index([artistId, businessDate])
  @@index([storeId, groupId, type, businessDate])
  @@index([storeId, reviewStatus, businessDate])
  @@map("attendance_report")
}

// ─────────────── 轮台派单日志(艺人设置⑧ 上钟模式;主管轮台报表数据源) ───────────────

model DispatchLog {
  id             Int      @id @default(autoincrement())
  storeId        Int      @map("store_id")
  businessDate   DateTime @map("business_date") @db.Date
  roomSessionId  Int?     @map("room_session_id")
  artistId       Int      @map("artist_id")
  groupId        Int?     @map("group_id")
  supervisorName String?  @map("supervisor_name") @db.VarChar(64)
  mode           String   @db.VarChar(16) // ROTATION/SELF_PICK/MIXED(开房时门店模式快照)
  position       Int      @default(0) // 该艺人当日第 N 次被派
  suggested      Boolean  @default(false) // 是否为引擎推荐位(轮到他)
  overridden     Boolean  @default(false) // 混合模式下越过推荐位人工指定
  reason         String?  @db.VarChar(255) // 越过原因
  operatorId     Int?     @map("operator_id")
  createdAt      DateTime @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id])

  @@index([storeId, businessDate])
  @@index([artistId, businessDate])
  @@map("dispatch_log")
}

// ─────────────── 场次(上下钟) ───────────────

model ShowSession {
  id              Int       @id @default(autoincrement())
  storeId         Int       @map("store_id")
  businessDate    DateTime  @map("business_date") @db.Date
  artistId        Int       @map("artist_id")
  roomId          Int?      @map("room_id")
  roomTypeId      Int?      @map("room_type_id")
  roomName        String?   @map("room_name") @db.VarChar(64)
  startAt         DateTime  @map("start_at")
  endAt           DateTime? @map("end_at")
  durationMinutes Int?      @map("duration_minutes")
  isCross         Boolean   @default(false) @map("is_cross")
  feeAmount       Decimal?  @map("fee_amount") @db.Decimal(10, 2)
  feeRuleId       Int?      @map("fee_rule_id")
  // 计费快照(需求全集 §6.4/§6.5:上钟时落单价与进位阈值,下钟按快照核算;门店改阈值不影响进行中场次)
  unitPrice       Decimal?  @map("unit_price") @db.Decimal(10, 2)
  billHours       Int?      @map("bill_hours")
  roundingMinutes Int?      @map("rounding_minutes")
  roundingEnabled Boolean?  @map("rounding_enabled") // 进位开关快照(NULL=旧数据,按当前配置兜底)
  feeMode         String?   @map("fee_mode") @db.VarChar(8) // HOURLY/FLAT 快照
  priceSlotName   String?   @map("price_slot_name") @db.VarChar(64) // 时段定价快照名(P0-2)
  billNo          String?   @map("bill_no") @db.VarChar(64)
  operatorId      Int?      @map("operator_id")
  // 房账关联(方案甲:下钟计费计入房账;关房结算时回填 room_session_id/settled_at)
  roomSessionId   Int?      @map("room_session_id")
  settledAt       DateTime? @map("settled_at")

  artist      Artist       @relation(fields: [artistId], references: [id])
  roomSession RoomSession? @relation(fields: [roomSessionId], references: [id])

  @@index([storeId, businessDate])
  @@index([artistId, startAt])
  @@index([storeId, roomId, startAt])
  @@map("show_session")
}

// ─────────────── P0-2 时段差异化定价(需求全集 §12:早/晚场/周末/节假日切换) ───────────────

model PricingSlot {
  id          Int       @id @default(autoincrement())
  storeId     Int       @map("store_id")
  roomTypeId  Int       @map("room_type_id")
  name        String    @db.VarChar(64) // 早场/晚场/周末/节假日
  daysOfWeek  Json?     @map("days_of_week") // 数字数组[0-6],0=周日;NULL=不限
  dateFrom    DateTime? @map("date_from") @db.Date
  dateTo      DateTime? @map("date_to") @db.Date
  startClock  String    @map("start_clock") @db.VarChar(5) // HH:mm(支持跨零点:start>end)
  endClock    String    @map("end_clock") @db.VarChar(5)
  unitPrice   Decimal   @map("unit_price") @db.Decimal(10, 2)
  priority    Int       @default(0) // 同命中取 priority 最高
  status      Int       @default(1)
  deletedAt   DateTime? @map("deleted_at")

